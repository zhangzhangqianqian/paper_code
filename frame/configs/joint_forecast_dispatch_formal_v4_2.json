    "stage_s_max_epochs": 30,
    "stage_j_max_epochs": 30,
    "minimum_stage_j_epochs": 18,
    "patience": 5,
    "validation_interval": 1,
    "rollin_start_fraction": 0.40,
    "model_history_fraction": 0.50,
    "rollin_refresh_epochs": 5,
    "forecast_weight": 1.0,
    "imitation_start_weight": 1.0,
    "imitation_final_weight": 0.0,
    "decision_start_weight": 0.05,
    "decision_final_weight": 1.0,
    "curriculum_ramp_epochs": 18,
    "forecast_task_weights": [1.0, 1.0, 1.0, 0.25]
