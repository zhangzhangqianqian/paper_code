    "fit_years": [2015, 2016, 2017, 2018],
    "cooling_shortage_energy_ratio_max": 0.005,
    "cooling_shortage_hour_rate_max": 0.01
  },
  "renewable_forecast": {
    "method": "last_value_persistence",
    "history_hours": 1,
    "horizon": 4,
    "selection_locked": true
  },
  "paths": {
