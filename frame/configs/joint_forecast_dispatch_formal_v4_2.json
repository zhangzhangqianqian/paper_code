    {"name": "Decoupled-RSC-PF", "kind": "decoupled", "stochastic": true, "deployable": true, "online_exact_lp": false},
    {"name": "Direct-Policy", "kind": "direct_policy", "stochastic": true, "deployable": true, "online_exact_lp": false},
    {"name": "Scheme2R-PTO", "kind": "pto", "stochastic": true, "deployable": true, "online_exact_lp": true},
    {"name": "State-Conditioned-PTO", "kind": "pto", "stochastic": true, "deployable": true, "online_exact_lp": true},
    {"name": "Official iTransformer-PTO", "kind": "external_pto_adaptation", "stochastic": true, "deployable": true, "online_exact_lp": true},
    {"name": "Differentiable-LP", "kind": "differentiable_lp_adaptation", "stochastic": true, "deployable": true, "online_exact_lp": true},
    {"name": "Perfect-Information-MPC", "kind": "oracle_reference", "stochastic": false, "deployable": false, "online_exact_lp": true},
    {"name": "Seasonal-Naive-PTO", "kind": "deterministic_pto", "stochastic": false, "deployable": true, "online_exact_lp": true}
